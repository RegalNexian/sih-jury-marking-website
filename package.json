{
  "name": "sih-jury-marking-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run client\" \"npm run server:dev\" --names \"CLIENT,SERVER\" --prefix-colors \"cyan,magenta\"",
    "client": "vite",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "build": "vite build",
    "build:analyze": "vite build && npx vite-bundle-analyzer dist",
    "build:report": "vite build --reporter=verbose",
    "lint": "eslint .",
    "preview": "vite preview",
    "server:socket": "cd server && npm start",
    "server:socket:dev": "cd server && npm run dev", 
    "start": "concurrently \"npm run preview\" \"npm run server\" --names \"CLIENT,SERVER\" --prefix-colors \"cyan,magenta\"",
    "start:all": "npm run dev",
    "install:server": "cd server && npm install",
    "build:production": "npm run build",
    "deploy:render": "echo 'Deploy frontend to Vercel and server to Render - see RENDER_DEPLOYMENT.md'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "perf:audit": "npm run build && lighthouse http://localhost:4173 --output html --output-path ./lighthouse-report.html",
    "size:check": "npm run build && bundlesize"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "json2csv": "^6.0.0-alpha.2",
    "mongoose": "^8.18.1",
    "node-fetch": "^3.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "terser": "^5.44.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
